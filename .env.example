# =========================================================================
# Smart Prompt Generator — environment template
# Copy to `.env` and fill in real values. NEVER commit the real .env.
# =========================================================================

# --- Required: backend refuses to start without this (main.py) ------------
# Generate a strong random value, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# --- AI providers ---------------------------------------------------------
# Gemini handles English input; Groq handles Hinglish/Teluglish, scoring,
# enhance, test-prompt and auto-categorize.
# A single key works, or provide numbered variants for round-robin rotation:
#   GROQ_API_KEY_1 .. GROQ_API_KEY_19
#   GEMINI_API_KEY_1 .. GEMINI_API_KEY_14
GROQ_API_KEY=
GEMINI_API_KEY=

# --- Frontend -> backend --------------------------------------------------
# Runtime resolver (lib/api.ts) auto-targets localhost when served from
# localhost; otherwise it uses this value.
NEXT_PUBLIC_API_URL=https://your-domain.example/prompt_generator/api
# Optional override for the local backend base URL (default http://localhost:8000)
# NEXT_PUBLIC_API_URL_LOCAL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# --- Google OAuth (optional; email/password works without it) -------------
# Set NEXT_PUBLIC_GOOGLE_CLIENT_ID to enable the "Sign in with Google" button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- Deployment / base path ----------------------------------------------
# Set to "true" when serving the frontend under the /prompt_generator prefix.
USE_BASE_PATH=false

# --- Dev-only endpoints (MUST stay false/unset in production) --------------
ALLOW_TEMPLATE_MUTATIONS=false
ALLOW_PRO_TOGGLE=false
# FORCE_HSTS=false
